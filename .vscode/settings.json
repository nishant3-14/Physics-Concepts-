{
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "gitsync",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "sync-github.ps1"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex ×2 + git sync",
      "tools": ["pdflatex", "pdflatex", "gitsync"]
    }
  ]
}